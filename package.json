{
  "name": "iprep_pro",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sw.js",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run && playwright test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release": "pnpm build && pnpm test",
    "preview:cf": "wrangler dev",
    "deploy:cf": "pnpm build && wrangler deploy",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.3",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true,
    "es5-ext": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.160.1"
  }
}

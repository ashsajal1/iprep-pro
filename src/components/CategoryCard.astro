---
import type { CategoryWithStats } from '../lib/types';
import Icon from './Icon.astro';
import ProgressBar from './ProgressBar.astro';

interface Props {
	category: CategoryWithStats;
}

const { category: cat } = Astro.props;

const accents: Record<string, string> = {
	amber: 'bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400',
	sky: 'bg-sky-100 text-sky-700 dark:bg-sky-500/10 dark:text-sky-400',
	blue: 'bg-blue-100 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400',
	zinc: 'bg-zinc-200 text-zinc-700 dark:bg-zinc-500/10 dark:text-zinc-300',
	emerald: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400',
	rose: 'bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-400',
	orange: 'bg-orange-100 text-orange-700 dark:bg-orange-500/10 dark:text-orange-400',
	violet: 'bg-violet-100 text-violet-700 dark:bg-violet-500/10 dark:text-violet-400',
	cyan: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-400',
	teal: 'bg-teal-100 text-teal-700 dark:bg-teal-500/10 dark:text-teal-400',
	fuchsia: 'bg-fuchsia-100 text-fuchsia-700 dark:bg-fuchsia-500/10 dark:text-fuchsia-400',
};
const accentClass = accents[cat.accent] ?? accents.zinc;
---

{
	cat.soon ? (
		<div
			class="card flex flex-col border-dashed p-5 opacity-80"
			data-category-card={cat.id}
			data-total="0"
		>
			<div class="flex items-center justify-between">
				<span class={`grid h-10 w-10 place-items-center rounded-xl ${accentClass}`}>
					<Icon name={cat.icon} class="h-5 w-5" />
				</span>
				<span class="chip bg-surface-raised text-[color:var(--ink-muted)]">Coming soon</span>
			</div>
			<h3 class="mt-4 font-semibold">{cat.name}</h3>
			<p class="mt-1 line-clamp-2 text-sm leading-relaxed text-[color:var(--ink-secondary)]">
				{cat.description}
			</p>
		</div>
	) : (
		<a
			href={`/${cat.id}`}
			class="card group flex flex-col p-5 transition-all duration-150 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:hover:border-indigo-800"
			data-category-card={cat.id}
			data-total={cat.count}
		>
			<div class="flex items-center justify-between">
				<span class={`grid h-10 w-10 place-items-center rounded-xl ${accentClass}`}>
					<Icon name={cat.icon} class="h-5 w-5" />
				</span>
				<span class="text-xs font-medium tabular-nums text-[color:var(--ink-muted)]" data-count-label>
					{cat.count} questions
				</span>
			</div>

			<h3 class="group-hover:text-indigo-700 mt-4 font-semibold transition-colors dark:group-hover:text-indigo-300">
				{cat.name}
			</h3>
			<p class="mt-1 mb-4 line-clamp-2 text-sm leading-relaxed text-[color:var(--ink-secondary)]">
				{cat.description}
			</p>

			<ProgressBar progressFor={`category:${cat.id}`} label="Progress" value={0} />
		</a>
	)
}
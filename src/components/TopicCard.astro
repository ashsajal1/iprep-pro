---
import type { TopicMeta } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
	topic: TopicMeta;
	categoryId: string;
	count: number;
	index: number;
}

const { topic, categoryId, count, index } = Astro.props;
---

<a
	href={`/${categoryId}#${topic.id}`}
	class="card group flex items-center gap-4 p-4 transition-colors hover:border-indigo-300 dark:hover:border-indigo-800"
	data-topic-card={topic.id}
>
	<span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-surface-raised text-sm font-semibold tabular-nums text-[color:var(--ink-secondary)] group-hover:bg-indigo-50 group-hover:text-indigo-600 dark:group-hover:bg-indigo-950/60 dark:group-hover:text-indigo-400">
		{index + 1}
	</span>
	<span class="min-w-0 flex-1">
		<span class="block truncate text-sm font-medium">{topic.name}</span>
		<span class="block truncate text-xs text-[color:var(--ink-muted)]">{count} questions</span>
	</span>
	<Icon name="chevron-right" class="h-4 w-4 shrink-0 text-zinc-300 transition-transform group-hover:translate-x-0.5 group-hover:text-indigo-500 dark:text-zinc-600" />
</a>
---
import type { Difficulty } from '../lib/types';

interface Props {
	difficulty: Difficulty;
	size?: 'sm' | 'md';
}

const { difficulty, size = 'sm' } = Astro.props;

const styles: Record<Difficulty, string> = {
	beginner: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-500/10 dark:text-emerald-400 dark:ring-emerald-400/20',
	intermediate:
		'bg-amber-50 text-amber-700 ring-amber-600/25 dark:bg-amber-500/10 dark:text-amber-400 dark:ring-amber-400/20',
	advanced:
		'bg-rose-50 text-rose-700 ring-rose-600/20 dark:bg-rose-500/10 dark:text-rose-400 dark:ring-rose-400/20',
};

const labels: Record<Difficulty, string> = {
	beginner: 'Beginner',
	intermediate: 'Intermediate',
	advanced: 'Advanced',
};
---

<span
	class:list={[
		'inline-flex items-center gap-1.5 rounded-full font-medium ring-1 ring-inset',
		styles[difficulty],
		size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs',
	]}
	data-difficulty={difficulty}
>
	<span class="h-1.5 w-1.5 rounded-full bg-current opacity-70"></span>
	{labels[difficulty]}
</span>

---
import Icon from './Icon.astro';

interface Props {
	icon?: string;
	title: string;
	message: string;
}

const { icon = 'sparkles', title, message } = Astro.props;
---

<div class="card flex flex-col items-center justify-center px-6 py-14 text-center">
	<div class="mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-indigo-50 text-indigo-500 dark:bg-indigo-950/60 dark:text-indigo-400">
		<Icon name={icon} class="h-6 w-6" />
	</div>
	<h3 class="text-base font-semibold">{title}</h3>
	<p class="mt-1.5 max-w-sm text-sm leading-relaxed text-[color:var(--ink-secondary)]">{message}</p>
	<slot />
</div>
---
import Icon from './Icon.astro';

interface Props {
	id: string;
	class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<button
	type="button"
	data-favorite-button={id}
	aria-pressed="false"
	aria-label="Add to favorites"
	title="Save to favorites"
	class:list={[
		'inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-zinc-400 transition-colors hover:bg-rose-50 hover:text-rose-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:hover:bg-rose-950/40',
		className,
	]}
>
	<Icon name="heart" class="h-[18px] w-[18px]" data-heart />
</button>

<style>
	button[aria-pressed='true'] {
		color: var(--color-rose-500);
	}
	button[aria-pressed='true'] [data-heart] {
		fill: currentColor;
	}
</style>
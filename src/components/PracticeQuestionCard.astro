---
import type { Question } from '../lib/types';
import { renderInline } from '../lib/format';
import DifficultyBadge from './DifficultyBadge.astro';
import FavoriteButton from './FavoriteButton.astro';
import Icon from './Icon.astro';

interface Props {
	question: Question;
	class?: string;
}

const { question: q, class: className = '' } = Astro.props;
---

<article
	class={`card group relative flex flex-col p-4 transition-all duration-150 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:hover:border-indigo-800 ${className}`}
	data-question-card
	data-qid={q.id}
	data-cat={q.category}
	data-cat-name={q.categoryName}
	data-topic={q.topic}
	data-topic-name={q.topicName}
	data-difficulty={q.difficulty}
	data-title={q.question.toLowerCase()}
>
	<div class="mb-3 flex items-start justify-between gap-2">
		<div class="flex flex-wrap items-center gap-1.5">
			<DifficultyBadge difficulty={q.difficulty} />
			<span class="chip bg-surface-raised text-[color:var(--ink-secondary)]">{q.topicName}</span>
		</div>
		<FavoriteButton id={q.id} />
	</div>

	<a href={`/practice/${q.category}?mode=learn`} class="flex min-w-0 flex-1 flex-col">
		<h3 class="text-[15px] font-medium leading-snug text-ink-secondary group-hover:text-ink" set:html={renderInline(q.question)} />
		<span data-status-indicator class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-[color:var(--ink-muted)]">
			Not practiced yet
		</span>
		<span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 transition-all group-hover:gap-2.5 dark:text-indigo-400">
			Practice this <Icon name="arrow-right" class="h-3.5 w-3.5" />
		</span>
	</a>
</article>

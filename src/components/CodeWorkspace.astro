---
import type { CodingChallenge } from '../lib/types';
import DifficultyBadge from './DifficultyBadge.astro';
import Icon from './Icon.astro';
import { highlight } from '../lib/highlight';

interface Props {
	challenge: CodingChallenge;
	nextSlug?: string;
}

const { challenge: c, nextSlug } = Astro.props;
const solutionHtml = await highlight(c.solution, 'js');

const testSummaries = c.tests.map((t) => ({
	call: `${t.fn}(${t.args.map((a) => JSON.stringify(a)).join(', ')})`,
	expected: JSON.stringify(t.expected),
}));
---

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_330px]" id="workspace" data-challenge-id={c.id} data-next-slug={nextSlug ?? ''}>
	<!-- Editor column -->
	<section class="min-w-0 order-2 lg:order-1">
		<div class="mb-3 flex flex-wrap items-center gap-2">
			<button type="button" id="run-btn" class="btn btn-primary px-5">
				<Icon name="play" class="h-4 w-4 fill-current" />
				Run Tests
				<span class="kbd !border-0 !bg-white/15 !text-white hidden sm:inline-flex">Ctrl↵</span>
			</button>
			<button type="button" id="reset-btn" class="btn btn-secondary">
				<Icon name="refresh-cw" class="h-4 w-4" /> Reset
			</button>
			<span id="score-line" class="ml-auto text-sm font-medium tabular-nums text-ink-secondary"></span>
		</div>

		<div id="editor-mount" class="h-[420px] overflow-hidden rounded-xl border border-line bg-zinc-50 dark:bg-zinc-900"></div>

		<div id="output-panel" class="mt-4 space-y-3" aria-live="polite">
			<div id="run-banner" class="hidden rounded-xl px-4 py-3 text-sm font-medium"></div>

			<ul id="test-results" class="hidden divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface"></ul>

			<div id="console-wrap" class="hidden">
				<h3 class="mb-1.5 text-xs font-semibold tracking-wide text-ink-muted uppercase">Console</h3>
				<pre id="console-output" class="scroll-thin max-h-48 overflow-auto rounded-xl border border-line bg-zinc-50 p-3 font-mono text-xs leading-relaxed dark:bg-zinc-900"></pre>
			</div>
		</div>
	</section>

	<!-- Brief column -->
	<aside class="space-y-5 order-1 lg:order-2 lg:sticky lg:top-24 lg:self-start">
		<div class="card p-5">
			<div class="flex items-center justify-between gap-2">
				<DifficultyBadge difficulty={c.difficulty} />
				<span class="chip bg-surface-raised text-ink-secondary">{c.topic}</span>
			</div>
			<h2 class="mt-3 text-sm font-semibold tracking-wide text-ink-muted uppercase">Task</h2>
			<p class="mt-2 whitespace-pre-line text-[15px] leading-relaxed text-[color:var(--ink-secondary)]">{c.description}</p>
		</div>

		{
			c.hints.length > 0 && (
				<div class="card p-5">
					<div class="flex items-center justify-between">
						<h2 class="flex items-center gap-2 text-sm font-semibold">
							<Icon name="lightbulb" class="h-4 w-4 text-amber-500" /> Hints
						</h2>
						{c.hints.length > 1 && (
							<span id="hint-counter" class="text-xs tabular-nums text-ink-muted">
								0 / {c.hints.length}
							</span>
						)}
					</div>
					<button type="button" id="hint-btn" class="btn btn-soft mt-3 w-full">
						Reveal a hint
					</button>
					<ul id="hints-list" class="mt-3 space-y-2.5 empty:hidden">
						{c.hints.map((h) => (
							<li class="hidden rounded-lg bg-surface-raised px-3 py-2 text-sm leading-relaxed text-[color:var(--ink-secondary)]">{h}</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="card p-5">
			<h2 class="text-sm font-semibold">Verification tests</h2>
			<ul class="mt-3 space-y-1.5 font-mono text-xs">
				{
					testSummaries.map((t) => (
						<li class="flex items-center justify-between gap-2 rounded-lg bg-surface-raised px-2.5 py-1.5">
							<code class="truncate text-indigo-700 dark:text-indigo-300">{t.call}</code>
							<code class="shrink-0 text-ink-muted">→ {t.expected}</code>
						</li>
					))
				}
			</ul>
		</div>

		<details class="card group p-5">
			<summary class="cursor-pointer list-none text-sm font-medium text-ink-secondary transition-colors hover:text-rose-600 dark:hover:text-rose-400">
				⚠️ Reveal official solution
			</summary>
			<p class="mt-3 text-xs leading-relaxed text-ink-muted">Try solving it yourself first — struggling is where the learning happens.</p>
			<div class="codeblock mt-3 overflow-hidden rounded-xl border border-line bg-zinc-50 dark:bg-zinc-900" set:html={solutionHtml} />
		</details>

		{
			nextSlug && (
				<a href={`/coding/${nextSlug}`} class="card group flex items-center gap-3 p-4 transition-colors hover:border-indigo-300 dark:hover:border-indigo-800">
					<Icon name="arrow-right" class="h-4 w-4 text-indigo-500" />
					<span class="text-sm font-medium group-hover:text-indigo-700 dark:group-hover:text-indigo-300">Next challenge</span>
				</a>
			)
		}
	</aside>
</div>

<script is:inline type="application/json" data-challenge-data set:html={JSON.stringify({ starterCode: c.starterCode, tests: c.tests })} />
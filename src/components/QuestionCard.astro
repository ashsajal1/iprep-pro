---
import type { Question } from '../lib/types';
import DifficultyBadge from './DifficultyBadge.astro';
import FavoriteButton from './FavoriteButton.astro';
import Icon from './Icon.astro';

interface Props {
	question: Question;
	class?: string;
}

const { question: q, class: className = '' } = Astro.props;
---

<article
	class={`card group relative flex flex-col p-4 transition-all duration-150 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md dark:hover:border-indigo-800 ${className}`}
	data-question-card
	data-qid={q.id}
	data-cat={q.category}
	data-cat-name={q.categoryName}
	data-topic={q.topic}
	data-topic-name={q.topicName}
	data-difficulty={q.difficulty}
	data-title={q.question.toLowerCase()}
>
	<div class="mb-3 flex items-start justify-between gap-2">
		<div class="flex flex-wrap items-center gap-1.5">
			<DifficultyBadge difficulty={q.difficulty} />
			<span class="chip bg-surface-raised text-[color:var(--ink-secondary)]">{q.categoryName}</span>
			<span class="hidden chip bg-surface-raised text-[color:var(--ink-muted)] sm:inline-flex">{q.topicName}</span>
		</div>
		<FavoriteButton id={q.id} class="-mr-1 -mt-1" />
	</div>

	<a
		href={`/questions/${q.id}`}
		class="text-[15px] leading-snug font-medium after:absolute after:inset-0 group-hover:text-indigo-700 dark:group-hover:text-indigo-300"
	>
		{q.question}
	</a>

	<div class="mt-auto flex items-center gap-2 pt-3 text-xs text-[color:var(--ink-muted)]">
		<span data-status-indicator class="inline-flex items-center gap-1.5 font-medium text-[color:var(--ink-muted)]">
			<Icon name="eye" class="h-3.5 w-3.5" />
			Not practiced yet
		</span>
		<span class="ml-auto tabular-nums">#{q.seq}</span>
	</div>
</article>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import { categories } from '../../lib/content';

export function getStaticPaths() {
	return [
		...categories.map((c) => ({ params: { category: c.id } })),
		{ params: { category: 'all' } },
	];
}

const { category } = Astro.params;
const isAll = category === 'all';
const cat = categories.find((c) => c.id === category);

// Mode comes from the query string at runtime (?mode=learn|practice|quick).
const title = isAll
	? 'Mixed Practice — All Categories'
	: `${cat!.name} Practice — Learn, Drill & Quick Rounds`;
const description = isAll
	? 'Run practice sessions across every interview track with instant feedback and local progress tracking.'
	: `Practice ${cat!.name} interview questions in three modes: guided learning, answer-first drilling, and quick 10-question rounds.`;

const modes = [
	{ id: 'learn', icon: 'book-open', label: 'Learn' },
	{ id: 'practice', icon: 'target', label: 'Practice' },
	{ id: 'quick', icon: 'zap', label: 'Quick 10' },
];

const backHref = isAll ? '/practice' : `/${category}`;
const backLabel = isAll ? 'All tracks' : `${cat!.name} overview`;
---

<BaseLayout title={title} description={description}>
	<section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
		<!-- Header -->
		<div class="mb-5 flex flex-wrap items-center gap-3">
			<a href={backHref} class="btn btn-ghost !px-2.5 text-sm">
				<Icon name="chevron-left" class="h-4 w-4" />
				<span class="hidden sm:inline">{backLabel}</span>
			</a>

			<nav class="flex items-center rounded-xl border border-line bg-surface-raised p-1" aria-label="Practice mode">
				{
					modes.map((m) => (
						<a
							href={`/practice/${category}?mode=${m.id}`}
							data-mode-tab={m.id}
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-medium text-ink-secondary transition-colors hover:text-ink"
						>
							<Icon name={m.icon} class="h-3.5 w-3.5" />
							<span>{m.label}</span>
						</a>
					))
				}
			</nav>

			<div id="runner-meta" class="ml-auto text-sm font-medium text-ink-secondary tabular-nums"></div>
		</div>

		<ProgressBar value={0} progressFor="session" class="mb-8" />

		<!-- Runner mounts here -->
		<div id="practice-runner" data-category={category} class="min-h-[50vh]">
			<div class="card grid place-items-center p-16 text-sm text-ink-muted">Loading questions…</div>
		</div>
	</section>
</BaseLayout>

<script src="../../scripts/page-practice.ts"></script>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { allQuestions, getCategoriesWithStats } from '../lib/content';

const categories = getCategoriesWithStats();
const liveCategories = categories.filter((c) => !c.soon);
const totalQuestions = allQuestions.length;

const steps = [
	{
		icon: 'book-open',
		title: 'Learn',
		text: 'Read structured answers with explanations, examples and interview tips.',
	},
	{
		icon: 'target',
		title: 'Practice',
		text: 'Answer first, then reveal. Self-assess honestly to build real recall.',
	},
	{
		icon: 'refresh-cw',
		title: 'Review',
		text: 'Flagged questions return to your review list until they stick.',
	},
	{
		icon: 'trending',
		title: 'Progress',
		text: 'Watch completion, favorites and your streak grow — stored locally.',
	},
];

const features = [
	{
		icon: 'map',
		title: 'Guided roadmaps',
		text: 'Every category has a recommended learning order, so you always know what to study next.',
	},
	{
		icon: 'zap',
		title: 'Three practice modes',
		text: 'Learn step-by-step, practice answer-first, or run a quick 10-question round.',
	},
	{
		icon: 'search',
		title: 'Instant search',
		text: 'Press / anywhere and find any question in milliseconds.',
	},
	{
		icon: 'moon',
		title: 'Dark mode',
		text: 'A calm reading experience day or night, remembered across visits.',
	},
	{
		icon: 'lock',
		title: 'Private by design',
		text: 'No signup, no account, no tracking. Your progress lives in your browser only.',
	},
	{
		icon: 'graduation',
		title: 'Interview-ready answers',
		text: 'Short answers for recall, deep explanations for understanding, tips for delivery.',
	},
];
---

<BaseLayout
	title="iPrep Pro — Master Your Next Interview"
	description="Practice real interview questions with structured answers, guided learning paths and progress tracking. JavaScript, React, TypeScript, Next.js, Node.js and more. Free, no signup."
>
	<!-- Hero -->
	<section class="relative overflow-hidden">
		<div
			class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,oklch(0.55_0.2_280/0.08),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top,oklch(0.6_0.2_280/0.12),transparent_60%)]"
			aria-hidden="true"
		>
		</div>

		<div class="mx-auto max-w-6xl px-4 pt-16 pb-14 text-center sm:px-6 sm:pt-24 sm:pb-20">
			<p class="chip mx-auto mb-6 border border-line bg-surface text-ink-secondary">
				<Icon name="sparkles" class="h-3.5 w-3.5 text-indigo-500" />
				{totalQuestions} questions · {liveCategories.length} categories · 100% free
			</p>

			<h1 class="mx-auto max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
				Master Your Next
				<span class="bg-gradient-to-r from-indigo-500 via-violet-500 to-fuchsia-500 bg-clip-text text-transparent">Interview</span>
			</h1>

			<p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-pretty text-ink-secondary sm:text-lg">
				Learn and practice real interview questions step-by-step. Structured answers,
				guided learning paths and local progress tracking — no signup required.
			</p>

			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a href="/practice" class="btn btn-primary w-full px-7 py-3 text-base sm:w-auto">
					Start Practicing
					<Icon name="arrow-right" class="h-4 w-4" />
				</a>
				<a href="/questions" class="btn btn-secondary w-full px-7 py-3 text-base sm:w-auto">
					Explore Questions
				</a>
			</div>
		</div>
	</section>

	<!-- Continue where you left off (client-hydrated) -->
	<section id="continue-section" class="hidden mx-auto max-w-6xl px-4 sm:px-6 -mt-2 mb-2" aria-label="Continue learning">
		<a id="continue-link" href="#" class="card group flex items-center gap-4 p-4 transition-colors hover:border-indigo-300 dark:hover:border-indigo-800">
			<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400">
				<Icon name="play" class="h-4 w-4 fill-current" />
			</span>
			<span class="min-w-0 flex-1">
				<span class="block text-xs font-medium tracking-wide text-ink-muted uppercase">Continue where you left off</span>
				<span id="continue-title" class="block truncate text-sm font-semibold"></span>
			</span>
			<Icon name="chevron-right" class="h-5 w-5 shrink-0 text-zinc-300 transition-transform group-hover:translate-x-1 dark:text-zinc-600" />
		</a>
	</section>

	<!-- Categories -->
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="categories-heading">
		<div class="mb-8 flex items-end justify-between gap-4">
			<div>
				<h2 id="categories-heading" class="section-title">Learning categories</h2>
				<p class="mt-1.5 text-sm text-ink-secondary">Pick a track and follow its roadmap from fundamentals to advanced.</p>
			</div>
			<a href="/roadmap" class="hidden shrink-0 items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-500 sm:inline-flex dark:text-indigo-400">
				View roadmaps <Icon name="arrow-right" class="h-4 w-4" />
			</a>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{categories.map((cat) => <CategoryCard category={cat} />)}
		</div>
	</section>

	<!-- How it works -->
	<section class="border-y border-line bg-surface-raised/50 py-16" aria-labelledby="how-heading">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 id="how-heading" class="section-title text-center">Learn → Practice → Review → Progress</h2>
			<p class="mx-auto mt-2 max-w-xl text-center text-sm text-ink-secondary">
				A guided loop that builds lasting knowledge instead of endless scrolling.
			</p>

			<ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{
					steps.map((step, i) => (
						<li class="relative text-center">
							<span class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-surface shadow-xs ring-1 ring-line">
								<Icon name={step.icon} class="h-5 w-5 text-indigo-600 dark:text-indigo-400" />
							</span>
							<span class="absolute top-0 right-0 hidden text-5xl font-bold text-zinc-100 select-none lg:block dark:text-zinc-800" aria-hidden="true">
								{i + 1}
							</span>
							<h3 class="font-semibold">{step.title}</h3>
							<p class="mt-1.5 text-sm leading-relaxed text-ink-secondary">{step.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Features -->
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="features-heading">
		<h2 id="features-heading" class="section-title text-center">Everything you need to prepare</h2>
		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				features.map((f) => (
					<div class="card p-5">
						<span class="mb-3 grid h-9 w-9 place-items-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400">
							<Icon name={f.icon} class="h-[18px] w-[18px]" />
						</span>
						<h3 class="font-medium">{f.title}</h3>
						<p class="mt-1 text-sm leading-relaxed text-ink-secondary">{f.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- CTA band -->
	<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
		<div class="rounded-3xl bg-gradient-to-br from-indigo-600 to-violet-700 px-6 py-14 text-center text-white sm:px-12">
			<h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">Your next interview starts here</h2>
			<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-indigo-100">
				Jump into practice mode and answer your first question in under a minute.
			</p>
			<a href="/practice" class="btn mt-7 bg-white px-7 py-3 text-base font-medium text-indigo-700 hover:bg-indigo-50">
				Start Practicing
				<Icon name="arrow-right" class="h-4 w-4" />
			</a>
		</div>
	</section>
</BaseLayout>

<script>
	const CAT_NAMES: Record<string, string> = {
		javascript: 'JavaScript', react: 'React', typescript: 'TypeScript',
		nextjs: 'Next.js', nodejs: 'Node.js', 'html-css': 'HTML & CSS',
		'git-github': 'Git & GitHub', behavioral: 'Behavioral',
		'system-design': 'System Design', database: 'Database', 'web-dev': 'General Web Dev',
	};

	try {
		const p = JSON.parse(localStorage.getItem('iprep.progress.v1') ?? '{}') as { lastCategory?: string };
		if (p.lastCategory && CAT_NAMES[p.lastCategory]) {
			document.getElementById('continue-section')?.classList.remove('hidden');
			document.getElementById('continue-link')?.setAttribute('href', `/${p.lastCategory}`);
			const t = document.getElementById('continue-title');
			if (t) t.textContent = `${CAT_NAMES[p.lastCategory]} interview track`;
		}
	} catch {}
</script>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, categories } from '../../lib/content';

const sortedQuestions = [...allQuestions].sort((a, b) => b.order - a.order);
const topicOptions = new Map<string, string>();
for (const cat of categories) {
	for (const t of cat.topics) {
		topicOptions.set(t.id, `${cat.name} · ${t.name}`);
	}
}
---

<BaseLayout
	title="All Interview Questions — Browse & Search"
	description="Browse every interview practice question. Filter by category, difficulty and topic; sort by newest, difficulty or your progress."
>
	<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
		<header class="mb-8">
			<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Question bank</h1>
			<p class="mt-2 text-sm text-ink-secondary">
				{allQuestions.length} questions across {categories.length} categories.
				Press <kbd class="kbd">/</kbd> anywhere for global search.
			</p>
		</header>

		<!-- Filter bar -->
		<div class="card sticky top-16 z-20 mb-6 flex flex-wrap items-center gap-2 p-3 backdrop-blur-md" role="search" aria-label="Filter questions">
			<div class="relative min-w-[180px] flex-1">
				<Icon name="search" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-ink-muted" />
				<input
					id="filter-q"
					type="search"
					placeholder="Search this list…"
					class="input !pl-9"
					autocomplete="off"
				/>
			</div>

			<select id="filter-category" class="input w-auto min-w-[130px]" aria-label="Filter by category">
				<option value="">All categories</option>
				{categories.map((c) => <option value={c.id}>{c.name}</option>)}
			</select>

			<select id="filter-topic" class="input w-auto min-w-[140px]" aria-label="Filter by topic">
				<option value="">All topics</option>
				{[...topicOptions.entries()].map(([id, label]) => <option value={id}>{label}</option>)}
			</select>

			<select id="filter-difficulty" class="input w-auto min-w-[120px]" aria-label="Filter by difficulty">
				<option value="">Any difficulty</option>
				<option value="beginner">Beginner</option>
				<option value="intermediate">Intermediate</option>
				<option value="advanced">Advanced</option>
			</select>

			<select id="filter-sort" class="input w-auto min-w-[130px]" aria-label="Sort questions">
				<option value="newest">Newest</option>
				<option value="difficulty">Difficulty</option>
				<option value="alphabetical">A → Z</option>
				<option value="progress">Progress first</option>
			</select>

			<button id="filter-clear" type="button" class="btn btn-ghost hidden px-3 text-xs" aria-label="Clear all filters">
				Clear ✕
			</button>
		</div>

		<p id="results-count" class="mb-4 text-sm font-medium text-ink-secondary tabular-nums" aria-live="polite"></p>

		<div id="question-grid" class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			{sortedQuestions.map((q) => <QuestionCard question={q} />)}
		</div>

		<div id="empty-state" class="hidden">
			<EmptyState
				icon="search"
				title="No questions match"
				message="Try a different keyword or clear some filters — the answer you need is probably still in here."
			>
				<button type="button" id="empty-clear" class="btn btn-primary mt-5">Clear filters</button>
			</EmptyState>
		</div>
	</section>
</BaseLayout>

<script>
	const grid = document.getElementById('question-grid')!;
	const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-question-card]'));
	const qInput = document.getElementById('filter-q') as HTMLInputElement;
	const catSel = document.getElementById('filter-category') as HTMLSelectElement;
	const topicSel = document.getElementById('filter-topic') as HTMLSelectElement;
	const diffSel = document.getElementById('filter-difficulty') as HTMLSelectElement;
	const sortSel = document.getElementById('filter-sort') as HTMLSelectElement;
	const countEl = document.getElementById('results-count')!;
	const emptyEl = document.getElementById('empty-state')!;
	const clearBtn = document.getElementById('filter-clear')!;
	const emptyClear = document.getElementById('empty-clear')!;

	function readState() {
		return {
			q: new URLSearchParams(location.search).get('q') ?? '',
			cat: new URLSearchParams(location.search).get('category') ?? '',
			topic: new URLSearchParams(location.search).get('topic') ?? '',
			diff: new URLSearchParams(location.search).get('difficulty') ?? '',
			sort: new URLSearchParams(location.search).get('sort') ?? 'newest',
		};
	}

	function applyFilters() {
		const query = qInput.value.trim().toLowerCase();
		let visible = 0;

		for (const card of cards) {
			const matchQ =
				!query ||
				card.dataset.title!.includes(query) ||
				card.dataset.topicName!.toLowerCase().includes(query);
			const matchCat = !catSel.value || card.dataset.cat === catSel.value;
			const matchTopic = !topicSel.value || card.dataset.topic === topicSel.value;
			const matchDiff = !diffSel.value || card.dataset.difficulty === diffSel.value;
			const show = matchQ && matchCat && matchTopic && matchDiff;
			card.classList.toggle('hidden', !show);
			if (show) visible++;
		}

		// Sorting via DOM reordering
		const dir = [...cards];
		if (sortSel.value === 'alphabetical') {
			dir.sort((a, b) => a.dataset.title!.localeCompare(b.dataset.title!));
		} else if (sortSel.value === 'difficulty') {
			const rank: Record<string, number> = { beginner: 0, intermediate: 1, advanced: 2 };
			dir.sort((a, b) => rank[a.dataset.difficulty!] - rank[b.dataset.difficulty!]);
		} else if (sortSel.value === 'progress') {
			let progress: Record<string, number> = {};
			try { progress = JSON.parse(localStorage.getItem('iprep.progress.v1') ?? '{}').completed ?? {}; } catch {}
			const done = (el: HTMLElement) => (progress[el.dataset.qid!] ? 1 : 0);
			dir.sort((a, b) => done(a) - done(b));
		} else {
			dir.reverse(); // newest = reverse of default order
		}
		for (const el of dir) grid.appendChild(el);

		countEl.textContent = `Showing ${visible} of ${cards.length} questions`;
		emptyEl.classList.toggle('hidden', visible > 0);

		clearBtn.classList.toggle(
			'hidden',
			!(qInput.value || catSel.value || topicSel.value || diffSel.value),
		);

		// Sync URL without navigation
		const params = new URLSearchParams();
		if (qInput.value) params.set('q', qInput.value);
		if (catSel.value) params.set('category', catSel.value);
		if (topicSel.value) params.set('topic', topicSel.value);
		if (diffSel.value) params.set('difficulty', diffSel.value);
		if (sortSel.value !== 'newest') params.set('sort', sortSel.value);
		history.replaceState(null, '', params.size ? `/questions?${params}` : '/questions');
	}

	function resetInputs(state: ReturnType<typeof readState>) {
		qInput.value = state.q;
		catSel.value = state.cat;
		diffSel.value = state.diff;
		sortSel.value = state.sort;
		topicSel.value = state.topic;
	}

	// Init from URL params
	resetInputs(readState());
	[qInput, catSel, diffSel, sortSel].forEach((el) => el.addEventListener('change', applyFilters));
	qInput.addEventListener('input', applyFilters);
	topicSel.addEventListener('change', () => {
		catSel.value = '';
		applyFilters();
	});

	function clearAll() {
		qInput.value = '';
		catSel.value = '';
		topicSel.value = '';
		diffSel.value = '';
		sortSel.value = 'newest';
		applyFilters();
	}
	clearBtn.addEventListener('click', clearAll);
	emptyClear.addEventListener('click', clearAll);

	applyFilters();
</script>
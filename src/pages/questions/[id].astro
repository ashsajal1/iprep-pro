---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import AnswerSection from '../../components/AnswerSection.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import QuestionList from '../../components/QuestionList.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, getQuestionById, getRelatedQuestions, getQuestionsByCategory, getCategory } from '../../lib/content';
import { highlight } from '../../lib/highlight';

export function getStaticPaths() {
	return allQuestions.map((q) => ({ params: { id: q.id } }));
}

const { id } = Astro.params;
const q = getQuestionById(id!);
if (!q) return Astro.redirect('/404');

const category = getCategory(q.category)!;
const related = getRelatedQuestions(q);
const siblings = getQuestionsByCategory(q.category);
const idx = siblings.findIndex((x) => x.id === q.id);
const prev = idx > 0 ? siblings[idx - 1] : undefined;
const next = idx < siblings.length - 1 ? siblings[idx + 1] : undefined;

const exampleHtml = q.example ? await highlight(q.example, q.exampleLanguage ?? 'ts') : undefined;
---

<BaseLayout
	title={`${q.question} — ${category.name} Interview Question`}
	description={q.shortAnswer}
	ogType="article"
>
	<section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
		<nav class="mb-6 flex items-center gap-1.5 text-xs text-ink-muted" aria-label="Breadcrumb">
			<a href="/questions" class="hover:text-indigo-600">Questions</a>
			<Icon name="chevron-right" class="h-3 w-3" />
			<a href={`/${q.category}`} class="hover:text-indigo-600">{category.name}</a>
			<Icon name="chevron-right" class="h-3 w-3" />
			<span class="truncate text-ink-secondary">{q.topicName}</span>
		</nav>

		<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
			<!-- Main column -->
			<div>
				<article data-question-page data-qid={q.id}>
					<div class="flex flex-wrap items-center gap-2">
						<DifficultyBadge difficulty={q.difficulty} size="md" />
						<a href={`/${q.category}`} class="chip bg-surface-raised text-ink-secondary hover:bg-zinc-200 dark:hover:bg-zinc-800">
							{category.name}
						</a>
						<span class="chip bg-surface-raised text-ink-muted">{q.topicName}</span>
						<FavoriteButton id={q.id} class="ml-auto" />
					</div>

					<h1 class="mt-4 text-xl leading-snug font-semibold tracking-tight text-balance sm:text-2xl">
						{q.question}
					</h1>

					<!-- Think area -->
					<div id="think-area" class="mt-6 rounded-2xl border-2 border-dashed border-line p-8 text-center">
						<p class="text-sm font-medium text-ink-secondary">Take a moment.</p>
						<p class="mx-auto mt-1 max-w-sm text-xs leading-relaxed text-ink-muted">
							Say your answer out loud or write it down first — retrieval is what makes it stick.
							Reveal when you're ready.
						</p>
					</div>

					<!-- Actions -->
					<div class="mt-5 flex flex-wrap items-center gap-2.5">
						<button type="button" id="reveal-btn" class="btn btn-primary px-5 py-2.5">
							<Icon name="eye" class="h-4 w-4" />
							Show Answer
						</button>
						<div id="assess-actions" class="hidden flex-wrap items-center gap-2.5">
							<button type="button" id="know-btn" class="btn btn-success px-4 py-2.5">
								<Icon name="check" class="h-4 w-4" strokeWidth={2.4} />
								I Know This
							</button>
							<button type="button" id="review-btn" class="btn btn-danger-soft px-4 py-2.5">
								<Icon name="refresh-cw" class="h-4 w-4" />
								Need to Learn
							</button>
						</div>
					</div>

					<div id="assessment-feedback" class="hidden mt-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400"></div>

					<!-- Answer -->
					<noscript><style> #answer-section { display: block !important; }</style></noscript>
					<div id="answer-section" hidden class="mt-10">
						<AnswerSection question={q} exampleHtml={exampleHtml} />
					</div>
				</article>

				<!-- Related questions -->
				{
					related.length > 0 && (
						<section class="mt-12" aria-labelledby="related-heading">
							<h2 id="related-heading" class="section-title mb-5">Related questions</h2>
							<QuestionList questions={related} hideEmpty />
						</section>
					)
				}
			</div>

			<!-- Sidebar -->
			<aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
				<div class="card p-5">
					<h2 class="text-sm font-semibold">Your status</h2>
					<p id="status-pill" class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-surface-raised px-3 py-1.5 text-xs font-medium text-ink-secondary">
						Not practiced yet
					</p>
					<div class="mt-4 border-t border-line pt-4">
						<ProgressBar progressFor={`category:${q.category}`} value={0} label={`${category.name} progress`} />
					</div>
				</div>

				<nav class="card p-2" aria-label="Question navigation">
					{
						prev ? (
							<a href={`/questions/${prev.id}`} class="group flex items-start gap-3 rounded-xl px-3 py-2.5 hover:bg-surface-raised">
								<Icon name="chevron-left" class="mt-0.5 h-4 w-4 shrink-0 text-ink-muted group-hover:text-indigo-500" />
								<span class="min-w-0">
									<span class="block text-[11px] font-medium text-ink-muted uppercase">Previous</span>
									<span class="block truncate text-sm">{prev.question}</span>
								</span>
							</a>
						) : (
							<span class="px-3 py-2.5 text-sm text-ink-muted">Start of category</span>
						)
					}
					{
						next && (
							<a href={`/questions/${next.id}`} class="group flex items-start justify-end gap-3 rounded-xl px-3 py-2.5 text-right hover:bg-surface-raised">
								<span class="min-w-0">
									<span class="block text-[11px] font-medium text-ink-muted uppercase">Next up</span>
									<span class="block truncate text-sm">{next.question}</span>
								</span>
								<Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-ink-muted group-hover:text-indigo-500" />
							</a>
						)
					}
					<a href={`/practice/${q.category}?mode=learn`} class="btn btn-soft m-2 w-[calc(100%-1rem)] !justify-center">
						Practice all {category.name}
					</a>
				</nav>

				<div class="rounded-2xl border border-indigo-200 bg-indigo-50/70 p-5 dark:border-indigo-900/60 dark:bg-indigo-950/30">
					<h2 class="flex items-center gap-2 text-sm font-semibold text-indigo-700 dark:text-indigo-300">
						<Icon name="lightbulb" class="h-4 w-4" /> How to use this page
					</h2>
					<ol class="mt-3 space-y-2 text-xs leading-relaxed text-ink-secondary dark:text-zinc-300">
						<li>1. Answer out loud <em>before</em> revealing.</li>
						<li>2. Compare with the short answer & explanation.</li>
						<li>3. Be honest: “I know this” only if you nailed it.</li>
						<li>4. Save tricky ones to favorites for later review.</li>
					</ol>
				</div>
			</aside>
		</div>
	</section>
</BaseLayout>

<script src="../../scripts/page-question.ts"></script>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeWorkspace from '../../components/CodeWorkspace.astro';
import Icon from '../../components/Icon.astro';
import { allChallenges, getChallengeBySlug } from '../../lib/content';

export function getStaticPaths() {
	return allChallenges.map((c, i) => ({
		params: { slug: c.slug },
		props: { nextSlug: allChallenges[i + 1]?.slug },
	}));
}

const { slug } = Astro.params;
const challenge = getChallengeBySlug(slug!);
if (!challenge) return Astro.redirect('/404');

const { nextSlug } = Astro.props;
---

<BaseLayout
	title={`${challenge.title} — JavaScript Coding Challenge`}
	description={`Solve "${challenge.title}" in the browser: write JavaScript in the editor and verify your solution against ${challenge.tests.length} automated tests.`}
>
	<section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
		<nav class="mb-5 flex items-center gap-1.5 text-xs text-ink-muted" aria-label="Breadcrumb">
			<a href="/coding" class="hover:text-indigo-600">Coding challenges</a>
			<Icon name="chevron-right" class="h-3 w-3" />
			<span class="text-ink-secondary">{challenge.topic}</span>
		</nav>

		<header class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
			<h1 class="text-xl font-semibold tracking-tight sm:text-2xl">{challenge.title}</h1>
			<span class="text-sm tabular-nums text-ink-muted" data-solved-marker hidden>✓ Solved</span>
		</header>

		<CodeWorkspace challenge={challenge} nextSlug={nextSlug} />
	</section>
</BaseLayout>

<script src="../../scripts/page-coding.ts"></script>